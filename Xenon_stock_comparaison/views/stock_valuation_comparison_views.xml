<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_valuation_comparison_wizard_form" model="ir.ui.view">
        <field name="name">stock.valuation.comparison.wizard.form</field>
        <field name="model">stock.valuation.comparison.wizard</field>
        <field name="arch" type="xml">
            <form string="Comparaison de valorisation de stock">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <div class="oe_button_box" style="margin-bottom: 10px;">
                    <button name="action_compute" type="object"
                            string="Calculer" class="btn-primary"/>
                </div>
                <field name="line_ids" invisible="not line_ids">
                    <list create="false" delete="false" edit="false" editable="bottom">
                        <field name="product_id"/>
                        <field name="product_code"/>
                        <field name="qty_date1" sum="Total"/>
                        <field name="cost_date1"/>
                        <field name="value_date1" sum="Total"/>
                        <field name="qty_in" sum="Total"/>
                        <field name="qty_out" sum="Total"/>
                        <field name="qty_adjustment" sum="Total"/>
                        <field name="qty_theoretical" sum="Total"/>
                        <field name="qty_date2" sum="Total"/>
                        <field name="cost_date2"/>
                        <field name="value_date2" sum="Total"/>
                        <field name="qty_gap" sum="Total"
                               decoration-danger="qty_gap != 0"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <record id="action_stock_valuation_comparison_wizard" model="ir.actions.act_window">
        <field name="name">Comparaison de valorisation de stock</field>
        <field name="res_model">stock.valuation.comparison.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_stock_valuation_comparison"
              name="Comparaison de valorisation entre 2 dates"
              parent="stock.menu_stock_root"
              action="action_stock_valuation_comparison_wizard"
              sequence="90"/>

</odoo>
