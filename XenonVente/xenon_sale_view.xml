<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_order_form_xenon" model="ir.ui.view">
            <field name="name">sale.order.form.xenon</field>
            <field name="model">sale.order</field>
			<field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                 <!-- On place le champ warehouse_id sous l'adresse de livraison -->
                <xpath expr="//field[@name='partner_shipping_id']" position="after">
                    <field name="warehouse_id" options="{'no_open': True}"/>
                </xpath>
                
                <!-- Optionnel : retirer le champ de l'onglet 'Autres informations' pour éviter la duplication -->
                <!--<xpath expr="//field[@name='warehouse_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>-->
                
                <xpath expr="//button[@name='action_confirm'][1]" position="attributes">   
                    <attribute name="invisible">True</attribute>        
                </xpath>  
                <xpath expr="//button[@name='action_confirm'][2]" position="attributes">   
                    <attribute name="invisible">True</attribute>        
                </xpath>
        		<button name="action_confirm" position="attributes">
                    <attribute name="invisible">True</attribute> 
        		</button>
    		
                <xpath expr="//button[@name='action_quotation_send'][2]" position="attributes">   
                    <attribute name="invisible">True</attribute>        
                </xpath>  
                <xpath expr="//button[@name='action_quotation_send'][3]" position="attributes">   
                    <attribute name="invisible">True</attribute>        
                </xpath> 
                <!--<button name="action_quotation_send" position="replace"> installation module site e-commerce--> 
    			<button name="action_quotation_send" position="after">
                    <button 
                        name="action_quotation_send" 
                        string="Envoyer par mail" 
                        type="object" 
                        modifiers="tosend" 
                        class="btn-primary" 
                        data-hotkey="g"
                        invisible="state not in [&quot;tosend&quot;]"/> 
                </button>
                <!--<xpath expr="//form[1]/header[1]/field[@name='state']" position="after">
                    <button string="InDraft" name="sale.action_mass_cancel_orders" type="action" invisible="state in [&quot;draft&quot;]"/>
                </xpath>
                <xpath expr="//form[1]/header[1]/field[@name='state']" position="after">
                    <button string="NotinDraft" name="sale.action_mass_cancel_orders" type="action" invisible="state not in [&quot;draft&quot;]"/>
                </xpath>-->
        		<button name="action_quotation_send" position="before">
                    <!--<button name="action_quotation_send" string="Envoyer par mail" type="object" states="tosend" class="btn-primary" data-hotkey="g"/>--> 
                    <button name="action_dempx" id="action_dempx"
                            string="DemandePx" class="btn-primary" type="object"
                            invisible="state not in [&quot;draft&quot;]"
                            confirm="Etes-vous sûr(e) d'avoir sélectionné le bon entrepôt ?"/>
                    <button name="action_confirmx" id="action_confirmx"
                            string="Confirmer" class="btn-primary" type="object"
                            invisible="state not in [&quot;sent&quot;]"/>
                    <button name="action_aenvoyerx" id="action_aenvoyerx"
                            string="A envoyer" class="btn-primary" type="object"
                            invisible="state not in [&quot;tosend&quot;]"/>/>
    				<button name="action_confirmersansmailx" id="action_confirmersansmailx"
                            string="Confirmer sans envoi mail" class="btn-primary" type="object"
                            invisible="state not in [&quot;tosend&quot;]"/>/>
                </button>
                <button name="action_cancel" position="replace">
                    <button name="action_cancel" type="object" string="Annuler"/>
                </button>
    			<field name="state" position="replace">
    				<field name="state" widget="statusbar" statusbar_visible="draft,wait,tosend,sent,sale"/>
                </field>
			</field>
 </record>
 
	<record id="view_order_tree_xenon" model="ir.ui.view">
		<field name="name">sale.order.tree.xenon</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_order_tree"/>
		<field name="arch" type="xml">
		<xpath expr="//field[@name='amount_total']" position="after">
			<field name="x_amount_filtre" optional="show"/>
		</xpath>
		</field>
	</record>

    <record id="view_quotation_tree_xenon" model="ir.ui.view">
        <field name="name">sale.order.tree.xenon</field>
        <field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
		<xpath expr="//field[@name='amount_total']" position="after">
			<field name="x_amount_filtre" optional="show"/>
		</xpath>
        </field>
    </record>
	
	<!-- Ajout filtre recherche par code analytique sur la vue liste des commandes -->
    <record id="sale_order_view_search_analytic" model="ir.ui.view">
        <field name="name">sale.order.search.analytic</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <search>
                <field name="order_line"
                       string="Code analytique"
                       filter_domain="[('order_line.distribution_analytic_account_ids.name', 'ilike', self)]"/>
            </search>
        </field>
    </record>
</odoo>


