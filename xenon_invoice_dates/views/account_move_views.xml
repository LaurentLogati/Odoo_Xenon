<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_xenon_dates" model="ir.ui.view">
        <field name="name">xenon.account.move.form.dates</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="start_date" optional="show" string="Date début"/>
                <field name="end_date" optional="show" string="Date fin"/>
            </xpath>
        </field>
    </record>
</odoo>
