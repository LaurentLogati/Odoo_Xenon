<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ╔════════════════════════════════════════════╗ -->
    <!-- ║   VUE LISTE (Tree) du modèle x_budget       ║ -->
    <!-- ╚════════════════════════════════════════════╝ -->
    <record id="view_budget_list_xenon" model="ir.ui.view">
      <field name="name">budget.list.xenon</field>
      <field name="model">x_budget</field>
      <field name="arch" type="xml">
        <list string="Budgets">
          <field name="x_libelle"/>
          <field name="x_company_id"/>
          <field name="x_datedebut"/>
          <field name="x_datefin"/>
          <field name="x_statut"/>
        </list>
      </field>
    </record>


    <!-- ╔════════════════════════════════════════════╗ -->
    <!-- ║   VUE TREE du modèle x_budget.detail        ║ -->
    <!-- ╚════════════════════════════════════════════╝ -->
    <record id="view_budget_detail_tree_xenon" model="ir.ui.view">
      <field name="name">budget.detail.tree.xenon</field>
      <field name="model">x_budget.detail</field>
      <field name="arch" type="xml">
        <tree editable="bottom" string="Détails du budget">
          <field name="x_compte"/>
          <field name="x_montant_1"/>
          <field name="x_montant_2"/>
          <field name="x_montant_3"/>
          <field name="x_montant_4"/>
          <field name="x_montant_5"/>
          <field name="x_montant_6"/>
          <field name="x_montant_7"/>
          <field name="x_montant_8"/>
          <field name="x_montant_9"/>
          <field name="x_montant_10"/>
          <field name="x_montant_11"/>
          <field name="x_montant_12"/>
        </tree>
      </field>
    </record>


    <!-- ╔════════════════════════════════════════════╗ -->
    <!-- ║   VUE FORM du modèle x_budget               ║ -->
    <!-- ╚════════════════════════════════════════════╝ -->
    <record id="view_budget_form_xenon" model="ir.ui.view">
      <field name="name">budget.form.xenon</field>
      <field name="model">x_budget</field>
      <field name="arch" type="xml">
        <form string="Budget">
          <sheet>
            <group>
              <field name="x_libelle"/>
              <field name="x_company_id"/>
              <field name="x_datedebut"/>
              <field name="x_datefin"/>
              <field name="x_exercice"/>
              <field name="x_statut"/>
              <field name="x_priorite"/>
              <field name="x_prevision"/>
            </group>

            <notebook>
              <page string="Détails du budget">
                <field name="x_detail_id"
                       context="{'default_x_liste_ids': active_id}"
                       mode="tree,form"
                       views="[(tree, ref('view_budget_detail_tree_xenon'))]"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>


    <!-- ╔════════════════════════════════════════════╗ -->
    <!-- ║   ACTION + MENU                            ║ -->
    <!-- ╚════════════════════════════════════════════╝ -->
    <record model="ir.actions.act_window" id="budget_action">
      <field name="name">Budgets Xenon</field>
      <field name="res_model">x_budget</field>
      <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_budget_xenon_root"
              name="Budget Xenon"
              parent="account.menu_finance"
              sequence="90"/>

    <menuitem id="menu_budget_xenon"
              name="Budgets"
              parent="menu_budget_xenon_root"
              action="budget_action"
              sequence="10"/>

  </data>
</odoo>
